# 管理员 Token（必填，用于 API 访问和管理界面登录）
ADMIN_TOKEN=change-me-please

# 紧急恢复：临时设为 true 并重启，重新绑定或关闭 2FA 后改回 false 并再次重启
# 启用 2FA 后若更改了 ADMIN_TOKEN，需要重新设置 2FA
# ADMIN_2FA_DISABLED=false

# 监听端口
# PORT=8787

# SQLite 数据库路径（未设置 DATABASE_URL 时使用）
# DB_PATH=./data/proxy.db

# PostgreSQL 数据库（多机部署时设置，所有机器指向同一个库；设置后优先于 DB_PATH）
# 格式：postgres://用户名[:密码]@主机:5432/库名?sslmode=require（密码按需填入，不要提交真实密码）
# DATABASE_URL=postgres://embyproxy@127.0.0.1:5432/embyproxy?sslmode=require

# 多机部署时的实例标识与通知优先级（仅设置 DATABASE_URL 的多机部署需要）
# INSTANCE_NAME 默认取本机 hostname，每台机器必须不同；INSTANCE_PRIORITY 数字越小优先级越高，
# 建议 A=1、B=2、C=3，通知（日报、保号提醒）只由当前最高优先级且在线的机器发送。
# INSTANCE_NAME=
# INSTANCE_PRIORITY=100

# 系统显示时区（不设置时默认正八区）
# TZ=Asia/Shanghai
